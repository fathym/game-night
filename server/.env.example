# Settings for this stack. Copy it and lock it down before filling anything in:
#   cp .env.example .env && chmod 600 .env
# .env is gitignored; this template is not, so never put real values here.

# The server's LAN address. Impostor's HTTP matchmaking listens only there, for the reverse proxy.
SERVER_LAN_IP=

# The server's Tailscale address, from `tailscale ip -4` (README.md, Step 0).
IMPOSTOR_PUBLIC_IP=

# The voice relay's bot token (README.md, Step 7).
DISCORD_TOKEN=

# Comma-separated Discord ids of the players who agreed to be recorded (README.md, Step 7).
GAMENIGHT_PLAYERS=
